# --- Composer / PHP ---
/vendor/
composer.phar

# --- Node / Frontend ---
/node_modules/
/html/bundle/*
!/html/bundle/.gitkeep

# --- キャッシュ・ログ ---
/var/*
!/var/.gitkeep
!/var/.htaccess

# --- プラグイン・テンプレート生成物 ---
/app/Plugin/*
!/app/Plugin/.gitkeep
/app/PluginData/*
!/app/PluginData/.gitkeep
/app/proxy/entity/*
!/app/proxy/entity/.gitkeep

/html/plugin/*
!/html/plugin/.gitkeep
/html/upload/save_image/*
!/html/upload/save_image/.gitkeep
!/html/upload/save_image/no_image_product.png
/html/upload/temp_image/*
!/html/upload/temp_image/.gitkeep
/html/template/*
!/html/template/admin
!/html/template/default
!/html/template/install
/html/user_data/*
!/html/user_data/.gitkeep
!/html/user_data/assets/css/customize.css
!/html/user_data/assets/js/customize.js

# --- テスト関連（不要なので除外） ---
/tests/
/test/
/reports/

# --- 開発用ディレクトリ ---
/zap/

# --- 環境依存ファイル ---
.env
.maintenance

# --- IDE / Editor ---
.idea/
/.vscode/
*.php~

# --- 設定系（不要なもの） ---
*.neon

# --- PHPUnit / phpunit-bridge ---
.phpunit
/phpunit.xml

# --- PHP-CS-Fixer ---
/.php-cs-fixer.cache
/.php-cs-fixer.*.php
